@startuml architecture_theme
title CKCoreUI Theme Flow
skinparam shadowing false
skinparam defaultFontSize 12
skinparam componentStyle rectangle
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #C9B458
skinparam packageStyle rectangle

actor Developer

package "Application" {
    component "CKApp\n(ck_app.dart)" as CKApp
    note bottom of CKApp
      Entry point. Takes brand,
      optional brightness and themeMode.
      Resolves BOTH the light and dark
      theme for the brand, then picks
      the active one.
    end note
}

package "Foundation tokens\n(lib/src/foundation)" as Foundation {
    component "ckcoreColors\nckcoreTypography\nckcoreSpacing\nckcoreRadius" as TokensA
    component "ckcoreElevation  ckcoreShadows\nckcoreMotion  ckcoreOpacity\nckcoreBreakpoints" as TokensB
    component "ckcorePrimitiveColors\n(raw palette: neutral, semantic)" as Primitives
}

package "Brands\n(lib/src/themes/brands)" as Brands {
    component "CastleKeep\ncolors + typography\nlight / dark builders" as Castle
    component "SkyGo\ncolors + typography\nlight / dark builders" as Sky
}

package "Theme Resolution\n(lib/src/themes)" as Resolution {
    component "ckcoreThemeResolver\n(ckcore_theme_resolver.dart)" as Resolver
    note bottom of Resolver
      switch (brand, brightness)
      over the four built-in themes.
    end note

    component "CkcoreuiThemeData\n(ckcore_theme_data.dart)\n<<immutable bundle>>" as ThemeData
    note bottom of ThemeData
      brand, brightness, colors, typography,
      spacing, radius, elevation, shadows,
      motion, opacity, breakpoints, logos.
    end note

    component "BrandLogos\n(brand_logos.dart)\nmaster, symbol, name, nav" as Logos
}

package "Theme Provider" {
    component "ckcoreTheme / CkcoreuiTheme\n(ckcore_theme.dart)\n<<InheritedWidget>>" as Provider
    component "context.ckColors, ckSpacing,\nckTypography, ckRadius ...\nCKColors.of(context)" as Access
}

package "Flutter" {
    component "_materialFrom()\n(ck_app.dart)" as MaterialBuilder
    note bottom of MaterialBuilder
      Maps tokens onto Material
      ThemeData so stock Material
      widgets match the brand.
    end note
    component "Material ThemeData" as MaterialTheme
    component MaterialApp
}

package "Widgets" {
    component "CK* components\n(buttons, inputs, display, feedback,\nnavigation, overlays, data table)" as Components
    component "CKScreenLayout\n(template)" as Layout
    component "Text extensions\n.h1  .bold  .primary" as TextExt
    component "BrandIcon.brandLogoWidget\n(brand_icon.dart)" as BrandIcon

    note bottom of Components
      Components never know the active
      brand. They read tokens from the
      current theme. CKSideNav and
      CKDrawer use theme.logos.nav.
    end note
}

Developer --> CKApp : brand\nThemeMode\n(optional brightness)
CKApp --> Resolver : resolve(brand, brightness)

Resolver --> Castle
Resolver --> Sky

Foundation ..> Brands : token classes,\nraw palette,\ndefaults

Castle --> ThemeData : builds
Sky --> ThemeData : builds
Logos --> ThemeData : logos

ThemeData --> Provider : ckcoreTheme(data)
ThemeData --> MaterialBuilder
MaterialBuilder --> MaterialTheme
MaterialTheme --> MaterialApp
Provider ..> MaterialApp : wraps

Provider --> Access
Access --> Components
Access --> Layout
Access --> TextExt

Components --> BrandIcon : nav logo
BrandIcon --> Resolver : logos for brand
@enduml
