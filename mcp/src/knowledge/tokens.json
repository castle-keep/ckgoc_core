{
    "metadata": {
        "description": "Design tokens for ckcoreui - access via context extensions. Use the code token names; the designSpec section shows the design team's values and how they map to code.",
        "accessPattern": "context.ckColors.primary, context.ckSpacing.md, context.ckTypography.textLg, etc."
    },
    "colors": {
        "description": "Semantic color tokens - brand agnostic, theme-driven",
        "accessPattern": "context.ckColors.<tokenName>",
        "tokens": {
            "primary": "Brand primary color (CastleKeep: #02372E, SkyGo: #0070DE)",
            "primaryHover": "Primary on hover",
            "primaryActive": "Primary on press",
            "primaryDisabled": "Primary when disabled",
            "onPrimary": "Text/icon on primary",
            "secondary": "Secondary action color (neutral100 light, neutral500 dark)",
            "secondaryHover": "Secondary on hover",
            "secondaryActive": "Secondary on press",
            "onSecondary": "Text/icon on secondary",
            "accent": "Accent color for highlights",
            "onAccent": "Text/icon on accent",
            "background": "Page/app background",
            "surface": "Card/panel background",
            "surfaceVariant": "Alternate surface (e.g. table header and footer)",
            "surfaceElevated": "Elevated surface",
            "inverseSurface": "Inverse surface (e.g. snackbar)",
            "onBackground": "Text/icon on background",
            "onSurface": "Text/icon on surface",
            "onSurfaceVariant": "Text/icon on surfaceVariant",
            "onInverseSurface": "Text/icon on inverseSurface",
            "outline": "Border/divider color",
            "outlineVariant": "Secondary outline color",
            "error": "Error state color",
            "errorContainer": "Error background container",
            "onError": "Text/icon on error",
            "onErrorContainer": "Text/icon on errorContainer",
            "success": "Success state color",
            "successContainer": "Success background container",
            "onSuccess": "Text/icon on success",
            "onSuccessContainer": "Text/icon on successContainer",
            "warning": "Warning state color",
            "warningContainer": "Warning background container",
            "onWarning": "Text/icon on warning",
            "onWarningContainer": "Text/icon on warningContainer",
            "info": "Information state color",
            "infoContainer": "Info background container",
            "onInfo": "Text/icon on info",
            "onInfoContainer": "Text/icon on infoContainer",
            "neutral": "Neutral color",
            "neutralVariant": "Neutral variant",
            "shadow": "Shadow color",
            "scrim": "Scrim behind overlays",
            "ring": "Focus ring",
            "muted": "Muted surface",
            "onMuted": "Text/icon on muted",
            "tagLive": "Live badge color (onTagLive for its text)",
            "tagNew": "New badge color (onTagNew for its text)",
            "tagBeta": "Beta badge color (onTagBeta for its text)",
            "tagProStart": "Pro badge gradient start",
            "tagProEnd": "Pro badge gradient end (onTagPro for its text)"
        },
        "note": "The neutral0..neutral1000 scale and the success/warning/error/info light/dark/surface shades are primitives (ckcorePrimitiveColors), not members of context.ckColors."
    },
    "spacing": {
        "description": "15-step spacing scale - use for margins, padding, gaps",
        "accessPattern": "context.ckSpacing.<size>",
        "scale": {
            "none": "0px",
            "xxs": "2px - Extra extra small",
            "xs": "4px - Extra small",
            "sm": "8px - Small",
            "s12": "12px",
            "md": "16px - Medium (default)",
            "s20": "20px",
            "lg": "24px - Large",
            "xl": "32px - Extra large",
            "s40": "40px",
            "x2l": "48px - 2x large",
            "x3l": "64px - 3x large",
            "s80": "80px",
            "x4l": "96px - 4x large",
            "x5l": "128px - 5x large"
        },
        "examples": [
            "SizedBox(height: context.ckSpacing.md)",
            "Padding(padding: EdgeInsets.all(context.ckSpacing.lg))",
            "Row(children: [...], spacing: context.ckSpacing.sm)"
        ]
    },
    "typography": {
        "description": "Typography styles - predefined text scales",
        "accessPattern": "context.ckTypography.<style>",
        "styles": {
            "display2xl": "Display 2XL - 32px, weight 700 (Text.h1)",
            "displayXl": "Display XL - 28px, weight 700 (.h2)",
            "displayLg": "Display Large - 24px, weight 700 (.h3)",
            "displayMd": "Display Medium - 20px, weight 700 (.h4)",
            "displaySm": "Display Small - 18px, weight 500 (.h5)",
            "textXl": "Text XL - 20px, weight 400 (.h6)",
            "textLg": "Text Large - 18px, weight 400",
            "textMd": "Text Medium - 16px, weight 400",
            "textSm": "Text Small - 14px, weight 400",
            "textXs": "Text XS - 12px, weight 400",
            "labelXl": "Label XL - 18px, weight 500",
            "labelLg": "Label Large - 16px, weight 500",
            "labelMd": "Label Medium - 14px, weight 500",
            "labelSm": "Label Small - 12px, weight 500",
            "codeMd": "Code - monospace, 14px, weight 400"
        },
        "fontFamily": "Inter (400, 500, 600, 700, 800 weights, plus italic)",
        "examples": [
            "Text('Heading', style: context.ckTypography.displayMd)",
            "Text('Body text', style: context.ckTypography.textMd)",
            "Text('Page title').h1  // chainable helper; modifiers like .bold go first"
        ]
    },
    "radius": {
        "description": "Border radius values for rounded corners",
        "accessPattern": "context.ckRadius.<size>",
        "scale": {
            "none": "0px",
            "sm": "4px",
            "base": "6px (buttons, inputs)",
            "md": "8px",
            "lg": "12px",
            "xl": "16px",
            "x2l": "24px",
            "x3l": "32px",
            "full": "9999px (pills)"
        },
        "examples": [
            "BorderRadius.circular(context.ckRadius.md)",
            "RoundedRectangleBorder(borderRadius: BorderRadius.circular(context.ckRadius.lg))"
        ]
    },
    "elevation": {
        "description": "Z-index/elevation levels for stacking",
        "accessPattern": "context.ckElevation.<level>",
        "levels": {
            "none": "0",
            "xs": "1",
            "sm": "2",
            "md": "4",
            "lg": "8",
            "xl": "16"
        },
        "named": {
            "surface": "none",
            "card": "sm",
            "dropdown": "md",
            "modal": "lg",
            "toast": "xl"
        }
    },
    "shadows": {
        "description": "Predefined shadow effects. Each is a List<BoxShadow> (empty for none).",
        "accessPattern": "context.ckShadows.<size>",
        "types": {
            "none": "No shadow",
            "sm": "Subtle shadow",
            "md": "Medium shadow",
            "lg": "Large shadow",
            "xl": "Extra large shadow"
        },
        "examples": [
            "BoxDecoration(boxShadow: context.ckShadows.md)",
            "Card(elevation: context.ckElevation.md)"
        ]
    },
    "motion": {
        "description": "Animation durations and curves",
        "accessPattern": "context.ckMotion.<name>",
        "timings": {
            "instant": "50ms",
            "fast": "100ms",
            "normal": "200ms",
            "slow": "300ms",
            "lazy": "500ms"
        },
        "examples": [
            "AnimatedContainer(duration: context.ckMotion.normal, curve: context.ckMotion.standard, ...)",
            "TweenAnimationBuilder(duration: context.ckMotion.fast, ...)"
        ],
        "curves": {
            "standard": "easeInOut",
            "decelerate": "easeOut",
            "accelerate": "easeIn",
            "emphasized": "emphasized curve"
        }
    },
    "opacity": {
        "description": "Opacity levels for disabled/muted/hover states",
        "accessPattern": "context.ckOpacity.<state>",
        "levels": {
            "transparent": "0.0",
            "hover": "0.08",
            "subtle": "0.12",
            "disabled": "0.38",
            "scrim": "0.50",
            "muted": "0.60",
            "full": "1.0"
        }
    },
    "breakpoints": {
        "description": "Responsive breakpoints (minimum widths, logical px) for layouts",
        "accessPattern": "context.ckBreakpoints.<size>",
        "sizes": {
            "xs": "0px - Mobile small",
            "sm": "360px - Mobile",
            "md": "600px - Tablet",
            "lg": "840px - Desktop",
            "xl": "1200px - Large desktop",
            "x2l": "1600px - Extra large desktop"
        },
        "examples": [
            "if (MediaQuery.of(context).size.width >= context.ckBreakpoints.lg) { ... }",
            "Row(children: isTablet ? [...] : [...])"
        ]
    },
