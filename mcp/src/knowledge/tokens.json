{
    "metadata": {
        "description": "Design tokens for ckcoreui - access via context extensions",
        "accessPattern": "context.ckColors.primary, context.ckSpacing.md, context.ckTypography.textLg, etc."
    },
    "colors": {
        "description": "Semantic color tokens - brand agnostic, theme-driven",
        "accessPattern": "context.ckColors.<tokenName>",
        "tokens": {
            "primary": "Brand primary color (CastleKeep: #02372E, SkyGo: #0070DE)",
            "secondary": "Brand secondary color",
            "accent": "Accent color for highlights",
            "background": "Page/app background",
            "surface": "Surface/card background",
            "surfaceVariant": "Secondary surface color",
            "outline": "Border/divider color",
            "outlineVariant": "Secondary outline color",
            "error": "Error state color",
            "errorContainer": "Error background container",
            "onError": "Text/icon on error backgrounds",
            "success": "Success state color",
            "successContainer": "Success background container",
            "onSuccess": "Text/icon on success backgrounds",
            "warning": "Warning state color",
            "warningContainer": "Warning background container",
            "onWarning": "Text/icon on warning backgrounds",
            "info": "Information state color",
            "infoContainer": "Info background container",
            "onInfo": "Text/icon on info backgrounds",
            "tagGreen": "Tag green color",
            "tagBlue": "Tag blue color",
            "tagPurple": "Tag purple color",
            "tagOrange": "Tag orange color",
            "tagRed": "Tag red color",
            "tagYellow": "Tag yellow color",
            "tagPink": "Tag pink color",
            "neutral": "Neutral/gray color",
            "neutral50": "Neutral 50 (lighter)",
            "neutral100": "Neutral 100",
            "neutral200": "Neutral 200",
            "neutral300": "Neutral 300",
            "neutral400": "Neutral 400",
            "neutral500": "Neutral 500",
            "neutral600": "Neutral 600",
            "neutral700": "Neutral 700",
            "neutral800": "Neutral 800",
            "neutral900": "Neutral 900 (darker)"
        }
    },
    "spacing": {
        "description": "15-point spacing scale - use for margins, padding, gaps",
        "accessPattern": "context.ckSpacing.<size>",
        "scale": {
            "xxs": "2px - Extra extra small",
            "xs": "4px - Extra small",
            "sm": "8px - Small",
            "md": "16px - Medium (default)",
            "lg": "24px - Large",
            "xl": "32px - Extra large",
            "x2l": "48px - 2x large",
            "x3l": "64px - 3x large",
            "x4l": "96px - 4x large",
            "x5l": "128px - 5x large"
        },
        "examples": [
            "SizedBox(height: context.ckSpacing.md)",
            "Padding(padding: EdgeInsets.all(context.ckSpacing.lg))",
            "Row(children: [...], spacing: context.ckSpacing.sm)"
        ]
    },
    "typography": {
        "description": "Typography styles - predefined text scales",
        "accessPattern": "context.ckTypography.<style> or Theme.of(context).textTheme.<style>",
        "styles": {
            "displayX2l": "Display 2XL - 56px, weight 700",
            "displayXl": "Display XL - 48px, weight 700",
            "displayLg": "Display Large - 40px, weight 700",
            "displayMd": "Display Medium - 32px, weight 700",
            "displaySm": "Display Small - 28px, weight 700",
            "textXl": "Text XL - 20px, weight 400",
            "textLg": "Text Large - 18px, weight 400",
            "textMd": "Text Medium - 16px, weight 400",
            "textSm": "Text Small - 14px, weight 400",
            "textXs": "Text XS - 12px, weight 400",
            "labelXl": "Label XL - 20px, weight 600",
            "labelLg": "Label Large - 18px, weight 600",
            "labelMd": "Label Medium - 16px, weight 600",
            "labelSm": "Label Small - 14px, weight 600",
            "labelXs": "Label XS - 12px, weight 600",
            "codeDefault": "Code - monospace, 14px, weight 400"
        },
        "fontFamily": "Inter (400, 500, 600, 700 weights)",
        "examples": [
            "Text('Heading', style: context.ckTypography.displayMd)",
            "Text('Body text', style: Theme.of(context).textTheme.bodyMedium)"
        ]
    },
    "radius": {
        "description": "Border radius values for rounded corners",
        "accessPattern": "context.ckRadius.<size>",
        "scale": {
            "xs": "2px",
            "sm": "4px",
            "md": "8px",
            "lg": "12px",
            "xl": "16px",
            "x2l": "24px",
            "x3l": "32px",
            "x4l": "48px"
        },
        "examples": [
            "BorderRadius.circular(context.ckRadius.md)",
            "RoundedRectangleBorder(borderRadius: BorderRadius.circular(context.ckRadius.lg))"
        ]
    },
    "elevation": {
        "description": "Z-index/elevation levels for stacking",
        "accessPattern": "context.ckElevation.<level>",
        "levels": {
            "sm": "1",
            "md": "4",
            "lg": "8",
            "xl": "12",
            "x2l": "16"
        }
    },
    "shadows": {
        "description": "Predefined shadow effects",
        "accessPattern": "context.ckShadows.<size>",
        "types": {
            "sm": "Subtle shadow - elevation 1",
            "md": "Medium shadow - elevation 4",
            "lg": "Large shadow - elevation 8",
            "xl": "Extra large shadow - elevation 12",
            "x3l": "3x large shadow - elevation 16"
        },
        "examples": [
            "BoxDecoration(boxShadow: [context.ckShadows.md])",
            "Card(elevation: context.ckElevation.md)"
        ]
    },
    "motion": {
        "description": "Animation timing curves",
        "accessPattern": "context.ckMotion.<speed>",
        "timings": {
            "fast": "150ms",
            "normal": "300ms",
            "slow": "500ms"
        },
        "examples": [
            "AnimatedContainer(duration: context.ckMotion.normal, ...)",
            "TweenAnimationBuilder(duration: context.ckMotion.fast, ...)"
        ]
    },
    "opacity": {
        "description": "Opacity levels for disabled/hover/focus states",
        "accessPattern": "context.ckOpacity.<state>",
        "levels": {
            "enabled": "1.0",
            "hover": "0.8",
            "focus": "0.7",
            "disabled": "0.5",
            "faded": "0.3"
        }
    },
    "breakpoints": {
        "description": "Responsive breakpoints for layouts",
        "accessPattern": "context.ckBreakpoints.<size>",
        "sizes": {
            "xs": "< 480px - Mobile small",
            "sm": "480px - 640px - Mobile",
            "md": "640px - 1024px - Tablet",
            "lg": "1024px - 1440px - Desktop",
            "xl": "1440px - 1920px - Large desktop",
            "x2l": "> 1920px - Extra large desktop"
        },
        "examples": [
            "if (MediaQuery.of(context).size.width >= context.ckBreakpoints.lg) { ... }",
            "Row(children: isTablet ? [...] : [...])"
        ]
    }
}