{
    "name": "@ckcore/ui-mcp",
    "version": "0.1.0",
    "description": "MCP Server for ckcore/ui Flutter Design System - provides Copilot integration for component knowledge, tokens, and code generation",
    "author": "ckcore/ui team",
    "license": "MIT",
    "type": "module",
    "exports": "./dist/index.js",
    "bin": {
        "ckcore-ui-mcp": "./dist/index.js"
    },
    "files": [
        "dist",
        "src/knowledge"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc && npm run copy-knowledge",
        "copy-knowledge": "cp -r src/knowledge dist/",
        "dev": "tsc --watch",
        "start": "node dist/index.js",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typescript": "^5.0.0"
    },
    "keywords": [
        "mcp",
        "copilot",
        "flutter",
        "design-system",
        "ckgoc_core",
        "components",
        "design-tokens"
    ],
    "engines": {
        "node": ">=16.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/castle-keep/ckgoc_core.git",
        "directory": "mcp"
    },
    "publishConfig": {
        "access": "public"
    }
}
